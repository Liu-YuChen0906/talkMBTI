AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
PORT=3000
DATA_DIR=/var/lib/talkmbti
# Replace with your real IP; exact browser origin, no trailing slash.
PUBLIC_ORIGIN=http://YOUR_PUBLIC_IP
TRUST_PROXY=true

VISITOR_DAILY_TESTS=3
IP_DAILY_TESTS=8
GLOBAL_DAILY_TESTS=500
IP_DAILY_VISITORS=32
GLOBAL_DAILY_VISITORS=10000
VISITOR_DAILY_TOKENS=250000
IP_DAILY_TOKENS=1500000
GLOBAL_DAILY_TOKENS=10000000
VISITOR_DAILY_CALLS=84
IP_DAILY_CALLS=224
SESSION_MODEL_CALLS=28
GLOBAL_CONCURRENCY=3
VISITOR_REQUESTS_PER_MINUTE=60
IP_REQUESTS_PER_MINUTE=180
CAPTCHA_VISITOR_THRESHOLD=15
CAPTCHA_IP_THRESHOLD=60
CAPTCHA_NEW_VISITORS=3
MAX_ANSWER_CHARS=1000
MAX_OUTPUT_TOKENS=2500
